<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <h2>New Form detail List</h2>
    <form action="/listings" method="POST">
        <input type="text" name="listing[title]" placeholder="enter the title name">
        <br><br>
        <textarea name="listing[description]" cols="30" rows="13" placeholder="enter description"></textarea>
        <br><br>
        <input type="text" name="listing[image]" placeholder="enter image URL/Link">
        <br><br>
        <input type="number" name="listing[price]" placeholder="enter price">
        <br><br>
        <input type="text" name="listing[location]" placeholder="enter location">
        <br> <br>
        <input   name="listing[country]" placeholder="enter country">
         <br> <br>
         <button>Add</button>
    
    </form>
</body>
</html>
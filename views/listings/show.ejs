<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-3">
        <h2>Listing Details:</h2>
    </div>

    <div class="card col-6 offset-3">

        <img
            src="<%= listing.image || 'https://placehold.co/600x400?text=No+Image' %>"
            class="card-img-top show-img"
            alt="listing image"
        >

        <div class="card-body">
            <p class="card-text">
                <b><%= listing.title %></b>
                <br>

                <%= listing.description %>
                <br>

                ₹<%= listing.price != null
                    ? listing.price.toLocaleString("en-IN")
                    : "Price not available" %>
                <br>

                <%= listing.location %>
                <br>

                <%= listing.country %>
            </p>
        </div>
    </div>

    <div class="col-6 offset-3 mt-3">
        <div class="btns">
            <a
                href="/listings/<%= listing._id %>/edit"
                class="btn btn-dark"
            >
                Edit
            </a>

            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=DELETE"
                class="d-inline"
            >
                <button type="submit" class="btn btn-dark delete-btn">
                    Delete
                </button>
            </form>
        </div>
    </div>
</div>
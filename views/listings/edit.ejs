<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h2>Edit Listing data </h2>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
        <input type="text" name="listing[title]" value="<%= listing.title %>"/>
        <br><br>
        <textarea name="listing[description]"cols="30" rows="13"><%= listing.description %>"></textarea>
        <br><br>
        <input type="text"
         name="listing[image]"
          value="<%= listing.image %>"
          />
        <br><br>
        <input type="number" name="listing[price]"
         value="<%=listing.price %>"/>
        <br><br>
        <input type="text" name="listing[location]"
         value="<%= listing.location %>"/>
        <br> <br>
        <input   name="listing[country]"
         value="<%= listing.country %>"/>
         <br> <br>
         <button>edit</button>
    
    </form>
</body>
</html>










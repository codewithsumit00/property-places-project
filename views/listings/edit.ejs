 <%= layout("/layouts/boilerplate") %>

  <div class="row mt-3">
    <div class="col-8 offset-2">
   

    <h2>Edit Listing data  </h2>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">

        <div class="mb-3">
            <label for="title"  class="form-label"> Title </label>
             <input class="form-control" type="text" name="listing[title]" value="<%= listing.title %>"/>
        </div>
        

         <div class="mb-3">
            <label for="Description"  class="form-label"> Description </label>
            <textarea class="form-control" name="listing[description]"> <%= listing.description %> </textarea>
         </div>


        <div class="mb-3">
            <label for="image"  class="form-label"> image Link </label>
            <input 
            name="listing[image]"
            value="<%= listing.image %>"
            type="text"
            class="form-control"
          />
        </div>
        
 <div class="row">
        <div class="mb-3 col-md-4">
             <label for="price"  class="form-label"> price</label>
             <input class="form-control" type="number" name="listing[price]"
             value="<%=listing.price %>"/>
        </div>

        <div class="mb-3 col-md-4" >
        <label for="country"  class="form-label">country </label>
        <input   class="form-control" name="listing[country]"
         value="<%= listing.country %>"/>
        </div>

</div>


        <div class="mb-3">
             <label for="location"  class="form-label"> location </label>
             <input class="form-control" type="text" name="listing[location]"
             value="<%= listing.location %>"/>
        </div>
        
         <button class="btn btn-dark edit-btn mt-3">Edit</button>
    
    </form>

     
    </div>
  </div>








